# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
# Origin of the frontend allowed by CORS
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Auth (use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=

# Cloudinary (image/video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (SMS verification - Phase 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: external AI inference server (not used yet)
AI_INFERENCE_SERVER_URL=

# Seed scripts only (npm run seed:admin / seed:demo)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
# Folder of local images uploaded by seed:demo (defaults to Backend/uploads)
SEED_IMAGE_DIR=
