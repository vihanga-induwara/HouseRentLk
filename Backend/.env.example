# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
# Allowed frontend origin(s) for CORS, comma-separated. The first one is used in email links.
FRONTEND_URL=http://localhost:5173
# Number of reverse proxies in front of the API (Railway = 1). Defaults to 1 in production.
TRUST_PROXY=
# Requests per IP per 15 minutes across the API
RATE_LIMIT_MAX=1000
# Set to false on all but one instance if you run several API replicas
ENABLE_SCHEDULER=true

# Error monitoring (optional but recommended in production)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Python used for AI scripts and scrapers (python3 in the Docker image)
PYTHON_BIN=
AI_MAX_CONCURRENCY=4
# Inbox that receives contact-form messages (falls back to Settings.contactEmail)
SUPPORT_EMAIL=

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Auth (use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=

# Cloudinary (image/video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth cookie. Use COOKIE_SAMESITE=lax when frontend and API share a site
# (e.g. houserent.lk + api.houserent.lk, optionally COOKIE_DOMAIN=.houserent.lk).
# Use COOKIE_SAMESITE=none only if they are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Email (SMTP) for verification and password reset. Without SMTP_HOST, emails are
# printed to the console in development and rejected in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HouseRentLk <no-reply@houserent.lk>"

# Twilio (SMS phone verification). Without credentials, codes are printed to the
# console in development and rejected in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Seed scripts only (npm run seed:admin / seed:demo)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
# Folder of local images uploaded by seed:demo (defaults to Backend/uploads)
SEED_IMAGE_DIR=
